    <main class="main-content" style="padding: 2rem; overflow-y: auto;">

        <header style="margin-bottom: 2.5rem;">
            <h1 style="font-size: 1.8rem; font-weight: 800; color: #111; margin: 0 0 0.25rem;">Bienvenue</h1>
            <p style="color: #6b7280; margin: 0;">Statistiques des candidatures au aujourd'hui</p>
