            <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 2rem;">

                <div style="display: flex; flex-direction: column; align-items: center; gap: 0.5rem;">
                    <a href="https://www.linkedin.com/in/bastien-cantoni-876922386/" target="_blank" rel="noopener noreferrer"
                       style="width: 5rem; height: 5rem; border-radius: 50%; border: 2px solid #e5e7eb; display: flex; align-items: center; justify-content: center; background: #004dc0; color: white; font-size: 1.25rem; font-weight: 700; text-decoration: none; transition: opacity 0.2s;">BC</a>
                    <span style="font-size: 0.875rem; color: #374151; font-weight: 500;">Bastien Cantoni</span>
                </div>

                <div style="display: flex; flex-direction: column; align-items: center; gap: 0.5rem;">
                    <a href="https://www.linkedin.com/in/lucas-el-maknassi-a59b20284/" target="_blank" rel="noopener noreferrer"
                       style="width: 5rem; height: 5rem; border-radius: 50%; border: 2px solid #e5e7eb; display: flex; align-items: center; justify-content: center; background: #0ea5e9; color: white; font-size: 1.25rem; font-weight: 700; text-decoration: none;">LE</a>
                    <span style="font-size: 0.875rem; color: #374151; font-weight: 500;">Lucas El Maknassi</span>
